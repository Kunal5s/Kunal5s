# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# AI Image Generator API Key
IMAGE_GENERATOR_API_KEY=YOUR_IMAGE_GENERATOR_API_KEY_HERE

# API Ninjas Key (for News API, etc.)
API_NINJAS_KEY=YOUR_API_NINJAS_KEY_HERE

# Database Configuration (example)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=5432

# Server Port
PORT=3000

# Internal API Base URL (for scheduler to call its own app)
INTERNAL_API_BASE_URL=http://localhost:3000
